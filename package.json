{
  "name": "pokelister",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "seed:embeddings": "tsx scripts/seed-embeddings.ts",
    "worker": "tsx worker/index.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/backup.ts verify",
    "loadtest": "tsx scripts/loadtest.ts",
    "golden:export": "tsx scripts/golden-export.ts",
    "golden:baseline": "tsx scripts/golden-export.ts baseline",
    "reset:data": "tsx scripts/reset-data.ts",
    "smoke": "tsx scripts/smoke.ts",
    "repetition": "tsx scripts/repetition.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "edge": "tsx scripts/edge-cases.ts",
    "seed:volume": "tsx scripts/seed-volume.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^5.0.0",
    "next": "^15.5.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "supabase": "^2.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4"
    }
  }
}

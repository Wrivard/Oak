# ---------------------------------------------------------------------------
# Copie ce fichier en .env.local et remplis les valeurs.
# Invariant 6 de CLAUDE.md : aucun secret dans le repo. .env* est gitignoré.
# ---------------------------------------------------------------------------

# Connexion Postgres directe. C'est ce qu'utilisent le worker, les migrations,
# les scripts de seed et les tests.
#
#   local  (supabase start) : postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   cloud  (session pooler) : voir Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Supabase — API. Le projet cloud existe pour que le worker puisse tourner en
# continu plus tard ; le dev quotidien se fait sur la stack locale.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321

# Clé service_role. Ne touche JAMAIS le navigateur. Les route handlers et les
# server actions Next l'utilisent côté serveur, au même titre que le worker.
# Voir docs/05-production.md §4.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Identifiant de ce process dans jobs.locked_by. Doit être unique par instance.
WORKER_ID=worker-local-1

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Étapes ultérieures — laissés vides jusqu'à ce qu'on y arrive.
# Rien de ce qui suit n'est lu à l'étape 2.
# ---------------------------------------------------------------------------

# Étape 4 — dossier watché où le fi-7160 dépose les scans
INBOX_DIR=./inbox
PROCESSED_DIR=./processed

# Étape 7 — pricing (voir PROMPTS.md étape 1, choix de la source)
TCGAPI_KEY=

# Étape 9 — eBay Sell API (sandbox d'abord, voir docs/04-channels.md partie A)
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_REFRESH_TOKEN=

# Étape 10 — TCGplayer (automation Playwright, pas d'API publique)
TCGPLAYER_EMAIL=
TCGPLAYER_PASSWORD=

# Étape 9 — marketplace eBay (voir docs/04). EBAY_MARKETPLACE_ID: EBAY_US, EBAY_CA…
EBAY_MARKETPLACE_ID=EBAY_US

# Étape 7 — quota plus large sur pokemontcg.io (optionnel)
POKEMONTCG_API_KEY=

# Taille du pool Postgres PAR PROCESS. Le pooler Supabase en mode session
# est limite a 15 clients : worker + app + scripts doivent tenir dedans.
PG_POOL_MAX=5
